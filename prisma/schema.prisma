// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 日本人／外国人の区分。従業員本人（個人）は登録時に一度決めれば変わらないため
// Employee側に持たせる。外注（会社単位のEmployee）は日によって送られてくる
// チームの国籍が変わりうるため、代理打刻のたびにTimeEntry側で個別に選ぶ。
enum Nationality {
  JAPANESE
  FOREIGN
}

model Employee {
  id           String        @id @default(cuid())
  name         String
  isActive     Boolean       @default(true)
  // 平日19:30時点で本日の打刻がない場合に喚起メールを送るかどうか（管理画面の「喚起メール」で切替）。
  reminderEmailEnabled Boolean @default(true)
  // trueなら「外注（会社単位で代理打刻する）」を表すEmployeeレコード。ログインはできない
  // （AllowedEmailを紐付けない）。個々の作業員は区別せず、会社単位で人工を合算する。
  isSubcontractor Boolean     @default(false)
  // 通常の従業員（isSubcontractor: false）の国籍。外注（isSubcontractor: true）側では使わない。
  nationality  Nationality?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  timeEntries  TimeEntry[]
  allowedEmail AllowedEmail?
}

// Googleアカウントのホワイトリスト。ログイン時にこのテーブルにあるメールアドレスかどうかで
// 認可し、employeeIdで「誰の打刻か」を一意に識別する。employeeIdがnullの行は
// 打刻対象ではない管理者専用アカウント（現場に出ない管理者など）を表す。
model AllowedEmail {
  id         String    @id @default(cuid())
  email      String    @unique
  isAdmin    Boolean   @default(false)
  employeeId String?   @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Site {
  id          String      @id @default(cuid())
  name        String
  // 位置情報は任意（未設定でも現場を登録できる。地図表示・現在地からの距離順表示・
  // 近接重複検出は、設定されている現場同士でのみ行われる）。
  lat         Float?
  lng         Float?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  timeEntries TimeEntry[]
}

model TimeEntry {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id])

  // その日の稼働日。集計クエリで clockIn/clockOut の時刻から日付を導出しなくて済むように分離して持つ。
  workDate DateTime

  clockIn  DateTime?
  clockOut DateTime?

  // 補正前の元の打刻を保持（監査用）。手動補正の直前の値のみ保存する。
  originalClockIn    DateTime?
  originalClockOut   DateTime?
  isManuallyAdjusted Boolean   @default(false)
  adjustmentNote     String?
  adjustedAt         DateTime?
  adjustedByName     String? // 補正した本人のメールアドレス（セッションから記録、監査用）

  // 定時休憩（10:00-10:30 / 12:00-13:00 / 15:00-15:30）を休憩なしで稼働した場合にチェックする。
  // trueの休憩枠は稼働時間・人工の計算に含める（lib/ninku.ts の BREAK_WINDOWS と対応）。
  workedBreak1 Boolean @default(false)
  workedBreak2 Boolean @default(false)
  workedBreak3 Boolean @default(false)

  // その日その現場での作業内容メモ（任意）。管理者画面の打刻詳細でそのまま表示する。
  dailyReport String?

  // 外注（会社単位）の代理打刻のみ設定する、その打刻1件の国籍区分。同じ外注会社でも
  // 日によって日本人チーム/外国人チームが変わりうるため、打刻ごとに個別に選ぶ。
  // 通常の従業員の打刻はnullのままとし、集計時はEmployee.nationalityにフォールバックする。
  nationality Nationality?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adjustmentLogs TimeEntryAdjustmentLog[]

  @@index([employeeId, workDate])
  @@index([siteId, workDate])
}

// 手動修正（個別修正・ペア修正）の監査ログ。TimeEntry側のadjustedAt等は「直近1回分」しか
// 保持しないため、修正のたびに追記していく専用テーブルとして分離する。
// ペア修正（現場の切り替わり=A現場の退勤とB現場の出勤をまとめて直す操作）の場合は、
// 対になるもう片方のログをpairedLogIdで指し、2件セットの修正だったことを追跡できるようにする。
model TimeEntryAdjustmentLog {
  id              String    @id @default(cuid())
  timeEntryId     String
  timeEntry       TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  adjustedByEmail String
  reason          String?
  pairedLogId     String?

  beforeClockIn  DateTime?
  afterClockIn   DateTime?
  beforeClockOut DateTime?
  afterClockOut  DateTime?
  beforeSiteId   String?
  afterSiteId    String?

  createdAt DateTime @default(now())

  @@index([timeEntryId])
  @@index([createdAt])
}
